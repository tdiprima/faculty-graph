# Local configuration for the faculty graph pipeline.
#
# Copy this file to .env and fill in the values for your institution:
#
#     cp .env.example .env
#     $EDITOR .env
#
# .env is git-ignored. Real values, and any API key, stay out of version
# control. Anything already exported in your shell wins over what is set here,
# so a one-off override does not mean editing this file.

# ── Institution ──────────────────────────────────────────────────────

# Institution name as OpenAlex spells it. Confirm the exact spelling at
# https://api.openalex.org/institutions?search=
# Set it empty to search all institutions: broader recall, more false matches.
INSTITUTION_NAME="Example University"

# Affiliation substring for PubMed searches. Defaults to INSTITUTION_NAME.
# Use a shorter form when papers rarely write the full name out.
INSTITUTION_AFFILIATION="Example University"

# Research Organization Registry IRI(s) for your institution, from
# https://ror.org. Accepts a bare ID ("abc123456") or either IRI form.
#
# Separate several with commas when one institution has more than one
# registered entry. Every ROR listed here counts as "us", so a paper written
# jointly by two of them is internal rather than an outside collaboration.
#
#   https://ror.org/abc123456  Example University

INSTITUTION_ROR="https://ror.org/abc123456"

# ── RDF ──────────────────────────────────────────────────────────────

# Base IRI for every generated term. Must be absolute and end with "/".
# Use a namespace you control if you intend to publish the graph.
FG_BASE_URI="http://example.org/faculty-graph/"

# ── Source API access ────────────────────────────────────────────────

# Raises PubMed rate limits from 3 to 10 requests per second.
# Free, from https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=""

# Any email address gets OpenAlex's faster "polite pool".
OPENALEX_EMAIL=""

# ── Disambiguation ───────────────────────────────────────────────────

OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="gemma4"

# ── Logging ──────────────────────────────────────────────────────────

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL="INFO"
